{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApprovalPacket",
  "type": "object",
  "required": [
    "approval_id",
    "requested_action",
    "action_type",
    "risk_level",
    "affected_repositories",
    "requesting_agent",
    "required_approver_roles",
    "evidence_bundle",
    "evidence_hash",
    "expected_outcome",
    "rollback_plan",
    "constraints",
    "expires_at",
    "created_at",
    "status",
    "decision_options",
    "requested_authority",
    "risk_reason",
    "block_reasons",
    "audit_correlation_id"
  ],
  "properties": {
    "approval_id": { "type": "string", "minLength": 1 },
    "requested_action": { "type": "string", "minLength": 1 },
    "action_type": { "type": "string", "minLength": 1 },
    "risk_level": { "enum": ["low", "medium", "high", "critical"] },
    "affected_repositories": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "requesting_agent": { "type": "string", "minLength": 1 },
    "required_approver_roles": { "type": "array", "items": { "type": "string" } },
    "approved_roles": { "type": "array", "items": { "type": "string" } },
    "decision_ids": { "type": "array", "items": { "type": "string" } },
    "evidence_bundle": { "type": "object" },
    "evidence_hash": { "type": "string", "minLength": 32 },
    "expected_outcome": { "type": "string", "minLength": 1 },
    "rollback_plan": { "type": "string", "minLength": 1 },
    "constraints": { "type": "object" },
    "cost_impact": { "type": ["number", "null"] },
    "customer_supplier_impact": { "type": ["string", "null"] },
    "expires_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "consumed_at": { "type": "string", "format": "date-time" },
    "status": {
      "enum": [
        "pending",
        "partially_approved",
        "approved",
        "rejected",
        "expired",
        "changes_requested",
        "consumed"
      ]
    },
    "decision_options": {
      "type": "array",
      "items": { "enum": ["approve_once", "approve_with_limits", "reject", "request_changes", "always_reject"] }
    },
    "requested_authority": {
      "type": "object",
      "required": ["category", "effect", "requires_human_approval"],
      "properties": {
        "category": { "type": "string" },
        "effect": { "type": "string" },
        "requires_human_approval": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "risk_reason": { "type": "string" },
    "block_reasons": { "type": "array", "items": { "type": "string" } },
    "audit_correlation_id": { "type": ["string", "null"] },
    "binding_version": { "const": "1.0" },
    "action_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "consumed_action_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "exact_action": { "$ref": "#/$defs/exactAction" },
    "sdk_run_id": { "type": "string", "minLength": 1 },
    "sdk_interruption_index": { "type": "integer", "minimum": 0 }
  },
  "allOf": [
    {
      "if": { "required": ["exact_action"] },
      "then": { "required": ["binding_version", "action_digest"] }
    }
  ],
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "exactAction": {
      "type": "object",
      "required": [
        "binding_version",
        "action_type",
        "tool_name",
        "agent_name",
        "repository",
        "environment",
        "normalized_arguments",
        "action_digest"
      ],
      "properties": {
        "binding_version": { "const": "1.0" },
        "action_type": { "type": "string", "minLength": 1 },
        "tool_name": { "type": "string", "minLength": 1 },
        "agent_name": { "type": "string", "minLength": 1 },
        "repository": { "type": ["string", "null"] },
        "environment": { "type": ["string", "null"] },
        "normalized_arguments": { "$ref": "#/$defs/jsonValue" },
        "action_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
