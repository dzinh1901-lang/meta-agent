{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "src/**/*.js",
    "src/discovery/**/*.ts",
    "src/sdk/**/*.ts",
    "src/state/**/*.ts",
    "tests/sdk/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "src/sdk/tools.ts"]
}
