# OpenAI Agents SDK runtime. Keep real values in an ignored server-side environment file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_AGENTS_TRACING_DISABLED=0

# Trusted operator identity and role claims supplied by the hosting service.
COSMOS_OPERATOR_ID=local-operator
COSMOS_APPROVER_ROLES=
COSMOS_AUTHORIZED_REPOSITORIES=
COSMOS_MODE=approval_gated
COSMOS_STATE_FILE=.data/cosmos-state.json

# Optional read-only GitHub discovery. Never pass this value through a model tool argument.
GITHUB_READ_TOKEN=
COSMOS_DISCOVERY_MAX_FILE_BYTES=512000

# Optional Postgres/Supabase state adapter.
DATABASE_URL=
COSMOS_DATABASE_SCHEMA=public
COSMOS_DATABASE_TABLE_PREFIX=cosmos_
